<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OpenClawNode" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <!--
          Claw dark palette.
          Theme.Material3.DayNight.NoActionBar ships the M3 *baseline* purple for every
          color role that is not overridden here. Anything drawn by the View layer
          (text selection handles + caret, native tooltips, ProgressBar, Switch,
          WebView default background and form controls) reads those attributes, so
          they are all pinned to ClawDesignTheme's tokens to keep purple out.
        -->
        <item name="android:windowBackground">#FF030303</item>
        <item name="android:colorBackground">#FF030303</item>
        <item name="colorPrimary">#FF6EA8FF</item>
        <item name="colorOnPrimary">#FF050505</item>
        <item name="colorPrimaryContainer">#FF1A2A44</item>
        <item name="colorOnPrimaryContainer">#FFF8F8F8</item>
        <item name="colorSecondary">#FFA8A8A8</item>
        <item name="colorOnSecondary">#FF030303</item>
        <item name="colorSecondaryContainer">#FF1A1A1A</item>
        <item name="colorOnSecondaryContainer">#FFF8F8F8</item>
        <item name="colorTertiary">#FF6EA8FF</item>
        <item name="colorOnTertiary">#FF050505</item>
        <item name="colorTertiaryContainer">#FF1A2A44</item>
        <item name="colorOnTertiaryContainer">#FFF8F8F8</item>
        <item name="colorError">#FFFF6B6B</item>
        <item name="colorOnError">#FF050505</item>
        <item name="colorErrorContainer">#FF2C1414</item>
        <item name="colorOnErrorContainer">#FFFF6B6B</item>
        <item name="colorSurface">#FF0A0A0A</item>
        <item name="colorOnSurface">#FFF8F8F8</item>
        <item name="colorSurfaceVariant">#FF111111</item>
        <item name="colorOnSurfaceVariant">#FFA8A8A8</item>
        <item name="colorOutline">#FF242424</item>
        <item name="colorOutlineVariant">#FF3A3A3A</item>
        <item name="android:colorAccent">#FF6EA8FF</item>
        <item name="android:colorControlActivated">#FF6EA8FF</item>
        <item name="android:colorControlNormal">#FFA8A8A8</item>
        <item name="android:colorControlHighlight">#331A2A44</item>
        <item name="android:textColorPrimary">#FFF8F8F8</item>
        <item name="android:textColorSecondary">#FFA8A8A8</item>
        <item name="android:textColorTertiary">#FF707070</item>
        <item name="android:textColorHint">#FF707070</item>
        <item name="android:textColorHighlight">#336EA8FF</item>
    </style>
</resources>
